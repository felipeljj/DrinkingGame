[node name="Section1" type="Label" parent="ScrollContainer/VBoxContainer"]
layout_mode = 2
text = "📱 BÁSICO"
label_settings = SubResource("LabelSettings_text")
horizontal_alignment = 1

[node name="Text1" type="Label" parent="ScrollContainer/VBoxContainer"]
layout_mode = 2
text = "1. Selecione os packs de cartas que deseja jogar
2. Passe o celular de mão em mão na roda
3. Cada pessoa desliza para ver uma nova carta
4. Cumpra o desafio ou beba!"
label_settings = SubResource("LabelSettings_text")
horizontal_alignment = 1
autowrap_mode = 3

[node name="Section2" type="Label" parent="ScrollContainer/VBoxContainer"]
layout_mode = 2
text = "🎮 CONTROLES"
label_settings = SubResource("LabelSettings_text")
horizontal_alignment = 1

[node name="Text2" type="Label" parent="ScrollContainer/VBoxContainer"]
layout_mode = 2
text = "• Deslize para os lados para trocar de carta
• Toque no botão quando não puder deslizar
• Use o botão 'Sair' para ver o WRAPPED e voltar ao menu"
label_settings = SubResource("LabelSettings_text")
horizontal_alignment = 1
autowrap_mode = 3

[node name="Section3" type="Label" parent="ScrollContainer/VBoxContainer"]
layout_mode = 2
text = "🎨 PACKS DISPONÍVEIS"
label_settings = SubResource("LabelSettings_text")
horizontal_alignment = 1

[node name="Text3" type="Label" parent="ScrollContainer/VBoxContainer"]
layout_mode = 2
text = "• CLÁSSICO: Para todos os gostos
• NON-SENSE: Desafios bizarros e engraçados
• WEIRDO: Para quem gosta de agir como estranhão
• IDIOMAS: Teste suas habilidades linguísticas
• VOTAÇÃO: Quem é mais provável de...?
• SPICY: Conteúdo adulto (+18)
• Packs customizados"
label_settings = SubResource("LabelSettings_text")
horizontal_alignment = 1
autowrap_mode = 3

[node name="Section4" type="Label" parent="ScrollContainer/VBoxContainer"]
layout_mode = 2
text = "⚠️ AVISO"
label_settings = SubResource("LabelSettings_text")
horizontal_alignment = 1

[node name="Text4" type="Label" parent="ScrollContainer/VBoxContainer"]
layout_mode = 2
text = "Este jogo é feito exclusivamente para público adulto.
Não beba se for menor de idade.
Beba com responsabilidade e se divirta!"
label_settings = SubResource("LabelSettings_text")
horizontal_alignment = 1
autowrap_mode = 3

